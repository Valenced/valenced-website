{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "valenced-website",
  "compatibility_date": "2026-07-30",
  "main": ".output/server/index.mjs",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "no_bundle": true,
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "rules": [
    {
      "type": "ESModule",
      "globs": [
        "**/*.mjs",
        "**/*.js"
      ]
    }
  ]
}
